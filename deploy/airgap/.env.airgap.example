# =============================================================================
#  SPECTRE — .env AIR-GAP (SQLite / RHEL 9) — modèle prêt à remplir
#  Copier en : /opt/spectre/backend/.env   puis renseigner les valeurs vides.
#  Référence exhaustive et commentée : backend/.env.example
# =============================================================================

# --- Secret (OBLIGATOIRE) ---
# Générer :
#   /opt/spectre/venv/bin/python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=

# --- Hôtes autorisés (nom DNS et/ou IP du serveur) ---
ALLOWED_HOSTS=spectre.intra.cea.fr,127.0.0.1

# --- Base : SQLite (booléen strict) ---
USE_SQLITE=True
# Fichier SQLite hors de l'arborescence servie par Apache.
SQLITE_PATH=/opt/spectre/data/db.sqlite3

# --- Prod ---
DEBUG=False
# Réseau interne HTTP (pas de TLS local) → False pour éviter la boucle de redirection.
# Mettre True uniquement si Apache/IT sert bien en HTTPS.
SECURE_SSL_REDIRECT=False

# --- Statiques & médias (servis par Apache) ---
STATIC_ROOT=/opt/spectre/backend/staticfiles
MEDIA_ROOT=/opt/spectre/backend/media
MEDIA_URL=/api/media/

# --- CORS (même origine en prod ; renseigner l'URL d'accès par sûreté) ---
CORS_ALLOWED_ORIGINS=https://spectre.intra.cea.fr
