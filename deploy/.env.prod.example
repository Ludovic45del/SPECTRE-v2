# SPECTRE — Variables d'environnement PRODUCTION
# Copier ce fichier en `deploy/.env` sur le VPS et remplir les valeurs.
# NE PAS COMMITER deploy/.env (déjà ignoré par .gitignore).

# ---------- Django ----------

# Générer avec :
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=

# Hôtes autorisés (IP du VPS + 'localhost' pour les healthchecks internes Docker)
# Exemple : ALLOWED_HOSTS=135.125.205.135,localhost,nginx
ALLOWED_HOSTS=

# Origines autorisées CORS (URL d'accès navigateur)
# Exemple : CORS_ALLOWED_ORIGINS=https://135.125.205.135
CORS_ALLOWED_ORIGINS=

# ---------- PostgreSQL ----------

POSTGRES_DB=spectre
POSTGRES_USER=spectre
# Générer avec : openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------- TLS ----------

# IP publique du VPS — utilisée comme CN du certificat TLS auto-signé.
# Exemple : VPS_PUBLIC_IP=135.125.205.135
VPS_PUBLIC_IP=

# ---------- Let's Encrypt (HTTPS valide) ----------

# Nom de domaine pointant vers le VPS (enregistrement DNS A → VPS_PUBLIC_IP).
# Laisser vide = certificat auto-signé (warning navigateur).
# Exemple : DOMAIN=testlabo.fr
DOMAIN=

# Email pour les notifications d'expiration des certificats Let's Encrypt.
CERTBOT_EMAIL=
